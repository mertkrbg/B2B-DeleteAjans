# -----------------------------------------------------------------------------
# B2B Enterprise Portal - Environment Configuration Template
# -----------------------------------------------------------------------------

# Application Settings
APP_NAME="B2B Enterprise Portal"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://b2b.test
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr_TR

# Database Configuration (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=b2b_enterprise
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Mail Settings (Optional SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="bilgi@b2b.test"
MAIL_FROM_NAME="B2B Enterprise"

# Security & Session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
